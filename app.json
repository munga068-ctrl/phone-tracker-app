{
  "expo": {
    "name": "Phone Tracker",
    "slug": "phone-tracker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0f1115",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.munga068.phonetracker",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Phone Tracker to access your location so it can be found.",
          "locationAlwaysPermission": "Allow Phone Tracker to access your location in the background so it keeps reporting even when the app isn't open.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "./plugins/withBootReceiver.js"
    ]
  }
}
